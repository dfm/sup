rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read any, write only own doc
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid;
    }

    // Friendships: read if participant, create if requester, update/delete if participant
    match /friendships/{docId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.requestedBy
        && request.auth.uid in request.resource.data.users
        && request.resource.data.status == 'pending';

      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && request.resource.data.status == 'accepted';

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.users;
    }

    // Sups: write if sender, read if sender or recipient
    match /sups/{docId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.fromUid
            || request.auth.uid == resource.data.toUid);

      allow create, update: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;
    }
  }
}
